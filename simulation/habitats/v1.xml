<mujoco model="hammy_habitat_v1">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom condim="3" friction="0.7 0.005 0.0001"/>
    <joint damping="0.05" armature="0.001"/>
  </default>

  <worldbody>
    <!-- Bedding Floor Surface at z = 0.165 m inside the 1.00 m x 0.50 m Cage -->
    <geom name="bedding_floor" type="box" pos="0 0 0.0825" size="0.50 0.25 0.0825" rgba="0.91 0.87 0.78 1"/>

    <!-- Cage Acrylic Walls (1.00 m x 0.50 m x 0.40 m) -->
    <geom name="cage_wall_front" type="box" pos="0 -0.252 0.20" size="0.50 0.002 0.20" rgba="0.85 0.92 0.95 0.25"/>
    <geom name="cage_wall_back"  type="box" pos="0  0.252 0.20" size="0.50 0.002 0.20" rgba="0.85 0.92 0.95 0.25"/>
    <geom name="cage_wall_left"  type="box" pos="-0.502 0 0.20" size="0.002 0.25 0.20" rgba="0.85 0.92 0.95 0.25"/>
    <geom name="cage_wall_right" type="box" pos=" 0.502 0 0.20" size="0.002 0.25 0.20" rgba="0.85 0.92 0.95 0.25"/>

    <!-- Habitat Objects matching simulation/habitats/v1.json and blender/scene.blend -->
    <body name="prop_bowl_main" pos="0.28 -0.11 0.165">
      <geom name="geom_bowl" type="cylinder" size="0.041 0.018" pos="0 0 0.018" rgba="0.94 0.93 0.90 1"/>
    </body>

    <body name="prop_bottle_main" pos="0.433 -0.02 0.183">
      <geom name="geom_spout" type="capsule" fromto="0.022 0 0.04 0 0 0" size="0.004" rgba="0.78 0.80 0.82 1"/>
    </body>

    <body name="prop_hideout_main" pos="0.28 0.11 0.165">
      <geom name="geom_hideout" type="box" size="0.08 0.065 0.052" pos="0 0 0.052" rgba="0.46 0.30 0.18 1"/>
    </body>

    <body name="prop_tunnel_main" pos="-0.04 -0.05 0.165">
      <geom name="geom_tunnel" type="cylinder" size="0.04 0.10" euler="90 35 0" pos="0 0 0.035" rgba="0.38 0.28 0.20 1"/>
    </body>

    <body name="prop_wheel_main" pos="-0.30 0.13 0.165">
      <joint name="wheel_spin" type="hinge" axis="0 1 0" pos="0 0 0.15" damping="0.002"/>
      <geom name="geom_wheel" type="cylinder" size="0.14 0.045" euler="90 0 0" pos="0 0 0.15" rgba="0.68 0.46 0.26 1"/>
    </body>

    <body name="prop_chew_block_main" pos="0.17 -0.05 0.165">
      <geom name="geom_chew_block" type="box" size="0.014 0.014 0.014" pos="0 0 0.014" rgba="0.52 0.34 0.20 1"/>
    </body>

    <!-- Simplified Hamster Body (simple_agent_v1: 0.125 kg, 0.15 m length, planar x, y, yaw) -->
    <body name="ham_agent" pos="0.145 0.032 0.195">
      <joint name="agent_tx" type="slide" axis="1 0 0" damping="1.2"/>
      <joint name="agent_ty" type="slide" axis="0 1 0" damping="1.2"/>
      <joint name="agent_yaw" type="hinge" axis="0 0 1" damping="0.08"/>
      <geom name="ham_torso" type="capsule" fromto="-0.042 0 0 0.042 0 0" size="0.032" mass="0.125" rgba="0.76 0.48 0.22 1"/>
      <site name="ham_nose_site" pos="0.075 0 0.005" size="0.005" rgba="0.9 0.5 0.5 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="act_vx" joint="agent_tx" kv="2.5" ctrllimited="true" ctrlrange="-0.45 0.45"/>
    <velocity name="act_vy" joint="agent_ty" kv="2.5" ctrllimited="true" ctrlrange="-0.45 0.45"/>
    <velocity name="act_wz" joint="agent_yaw" kv="0.5" ctrllimited="true" ctrlrange="-6.0 6.0"/>
  </actuator>
</mujoco>

